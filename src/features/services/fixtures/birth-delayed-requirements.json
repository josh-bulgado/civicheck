{
  "definition": {
    "sections": [
      {
        "key": "case",
        "step": "case",
        "title": "Request details",
        "fields": [
          {
            "key": "event_date",
            "type": "date",
            "label": "Date of birth",
            "helpText": "We calculate the correct 0-79 or 80+ registration track from this date.",
            "required": true,
            "dateDirection": "past"
          },
          {
            "key": "event_place",
            "type": "text",
            "label": "Place of birth",
            "required": true,
            "placeholder": "e.g. Legazpi City, Albay"
          },
          {
            "key": "place_type",
            "type": "select",
            "label": "Where did the birth take place?",
            "options": [
              {
                "label": "Hospital / Clinic",
                "value": "hospital"
              },
              {
                "label": "Home",
                "value": "home"
              },
              {
                "label": "Other",
                "value": "other"
              }
            ],
            "blockKey": "birth_details",
            "required": false
          },
          {
            "key": "informant_relationship",
            "type": "select",
            "label": "Informant's relationship to the child",
            "options": [
              {
                "label": "Mother",
                "value": "mother"
              },
              {
                "label": "Father",
                "value": "father"
              },
              {
                "label": "Grandparent",
                "value": "grandparent"
              },
              {
                "label": "Guardian",
                "value": "guardian"
              },
              {
                "label": "Physician / Midwife",
                "value": "physician_midwife"
              },
              {
                "label": "Other",
                "value": "other"
              }
            ],
            "blockKey": "birth_details",
            "required": false
          },
          {
            "key": "informant_name",
            "type": "text",
            "label": "Informant's name",
            "blockKey": "birth_details",
            "required": false,
            "placeholder": "Full name of the person reporting the birth"
          },
          {
            "key": "has_foreign_parent",
            "type": "select",
            "label": "Is either parent a foreign national?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "required": true
          },
          {
            "key": "out_of_town",
            "type": "select",
            "label": "Was the person born outside Legazpi City?",
            "options": [
              {
                "label": "Yes — out-of-town registration",
                "value": "yes"
              },
              {
                "label": "No — born in Legazpi City",
                "value": "no"
              }
            ],
            "helpText": "Choose whether the person was born in Legazpi City or another city/municipality.",
            "required": true
          },
          {
            "key": "additional_identity",
            "type": "select",
            "label": "Is additional proof of identity applicable to your BRAP application?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "helpText": "Select Yes if additional identity proof is available or requested by CCRO.",
            "required": true,
            "visibleWhen": {
              "field": "program",
              "value": "brap",
              "operator": "equals"
            }
          }
        ]
      },
      {
        "key": "details",
        "step": "details",
        "title": "Your details",
        "fields": [
          {
            "key": "subjects",
            "type": "person_group",
            "label": "Person named on the record",
            "required": true
          },
          {
            "key": "contact_number",
            "type": "phone",
            "label": "Contact number",
            "blockKey": "contact_number",
            "required": false,
            "placeholder": "9171234567"
          }
        ]
      }
    ],
    "eventTiming": {
      "title": "This date is within the last 30 days",
      "behavior": "redirect_confirm",
      "ctaLabel": "Switch to On-Time Registration",
      "mismatch": "inside_window",
      "timezone": "Asia/Manila",
      "windowDays": 30,
      "description": "Use the registration type that matches the birth date.",
      "triggerField": "event_date",
      "targetServiceCode": "birth_ontime",
      "requireDocumentFirst": false
    },
    "caseSelector": {
      "title": "Answer a few questions about delayed registration",
      "outcomes": [
        {
          "when": {
            "match": "all",
            "conditions": [
              {
                "field": "age",
                "value": "0-79",
                "operator": "equals"
              },
              {
                "field": "program",
                "value": "brap",
                "operator": "equals"
              }
            ]
          },
          "serviceCode": "DCOLB-0079-BRAP"
        },
        {
          "when": {
            "match": "all",
            "conditions": [
              {
                "field": "age",
                "value": "0-79",
                "operator": "equals"
              },
              {
                "field": "program",
                "value": "normal",
                "operator": "equals"
              },
              {
                "field": "marital",
                "value": "marital",
                "operator": "equals"
              }
            ]
          },
          "serviceCode": "DCOLB-0079-NORMAL-MARITAL"
        },
        {
          "when": {
            "match": "all",
            "conditions": [
              {
                "field": "age",
                "value": "0-79",
                "operator": "equals"
              },
              {
                "field": "program",
                "value": "normal",
                "operator": "equals"
              },
              {
                "field": "marital",
                "value": "non-marital",
                "operator": "equals"
              }
            ]
          },
          "serviceCode": "DCOLB-0079-NORMAL-NONMARITAL"
        },
        {
          "when": {
            "match": "all",
            "conditions": [
              {
                "field": "age",
                "value": "80+",
                "operator": "equals"
              },
              {
                "field": "program",
                "value": "brap",
                "operator": "equals"
              }
            ]
          },
          "serviceCode": "DCOLB-80UP-BRAP"
        },
        {
          "when": {
            "match": "all",
            "conditions": [
              {
                "field": "age",
                "value": "80+",
                "operator": "equals"
              },
              {
                "field": "program",
                "value": "normal",
                "operator": "equals"
              },
              {
                "field": "marital",
                "value": "marital",
                "operator": "equals"
              }
            ]
          },
          "serviceCode": "DCOLB-80UP-NORMAL-MARITAL"
        },
        {
          "when": {
            "match": "all",
            "conditions": [
              {
                "field": "age",
                "value": "80+",
                "operator": "equals"
              },
              {
                "field": "program",
                "value": "normal",
                "operator": "equals"
              },
              {
                "field": "marital",
                "value": "non-marital",
                "operator": "equals"
              }
            ]
          },
          "serviceCode": "DCOLB-80UP-NORMAL-NONMARITAL"
        }
      ],
      "questions": [
        {
          "key": "program",
          "label": "How will the birth be registered?",
          "options": [
            {
              "label": "With BRAP assistance",
              "value": "brap"
            },
            {
              "label": "Standard registration",
              "value": "normal"
            }
          ]
        },
        {
          "key": "marital",
          "label": "Are the child’s parents legally married?",
          "options": [
            {
              "label": "Yes",
              "value": "marital"
            },
            {
              "label": "No",
              "value": "non-marital"
            }
          ]
        }
      ],
      "description": "Your answers help us select the correct service, fee, process, and requirements."
    },
    "schemaVersion": 1,
    "derivedAnswers": [
      {
        "key": "age",
        "kind": "age_band",
        "bands": [
          {
            "label": "0–79 years old",
            "value": "0-79",
            "maxAge": 79,
            "minAge": 0
          },
          {
            "label": "80 years old and above",
            "value": "80+",
            "minAge": 80
          }
        ],
        "label": "Age at registration",
        "required": true,
        "dateField": "event_date"
      },
      {
        "key": "attestation_age",
        "kind": "age_band",
        "dateField": "event_date",
        "label": "Age for sworn attestation",
        "required": true,
        "bands": [
          {
            "value": "under7",
            "label": "Under 7",
            "minAge": 0,
            "maxAge": 6
          },
          {
            "value": "7-17",
            "label": "7-17",
            "minAge": 7,
            "maxAge": 17
          },
          {
            "value": "18plus",
            "label": "18 and above",
            "minAge": 18
          }
        ]
      }
    ]
  },
