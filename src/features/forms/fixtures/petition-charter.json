{
  "definition": {
    "sections": [
      {
        "key": "case",
        "step": "case",
        "title": "Petition details",
        "fields": [
          {
            "key": "current_first_name",
            "type": "text",
            "label": "First name as currently recorded",
            "required": true,
            "visibleWhen": {
              "field": "change_first_name",
              "value": "yes",
              "operator": "equals"
            }
          },
          {
            "key": "new_first_name",
            "type": "text",
            "label": "New first name you want",
            "required": true,
            "visibleWhen": {
              "field": "change_first_name",
              "value": "yes",
              "operator": "equals"
            }
          },
          {
            "key": "first_name_ground",
            "type": "select",
            "label": "Why do you want to change the first name?",
            "options": [
              {
                "label": "The current first name is ridiculous, dishonorable, or very hard to write or pronounce",
                "value": "unbecoming"
              },
              {
                "label": "I have habitually and continuously used the new name and am publicly known by it",
                "value": "habitual"
              },
              {
                "label": "The change will avoid confusion",
                "value": "avoid_confusion"
              }
            ],
            "required": true,
            "visibleWhen": {
              "field": "change_first_name",
              "value": "yes",
              "operator": "equals"
            }
          },
          {
            "key": "employment_status",
            "type": "select",
            "label": "Are you currently employed?",
            "options": [
              {
                "label": "Yes, I have an employer",
                "value": "employed"
              },
              {
                "label": "No, I am self-employed or not employed",
                "value": "not_employed"
              }
            ],
            "helpText": "Employed petitioners need a certification from their employer. Others need an affidavit of non-employment or self-employment.",
            "required": true,
            "visibleWhen": {
              "field": "change_first_name",
              "value": "yes",
              "operator": "equals"
            }
          },
          {
            "key": "corrected_birth_date",
            "type": "date",
            "label": "Correct date of birth",
            "helpText": "Only the day and month can be corrected. The year must match the record.",
            "required": true,
            "visibleWhen": {
              "field": "correct_birth_day_month",
              "value": "yes",
              "operator": "equals"
            },
            "dateDirection": "past"
          },
          {
            "key": "record_type",
            "type": "select",
            "label": "Type of record with the error",
            "options": [
              {
                "label": "Birth Certificate",
                "value": "birth"
              },
              {
                "label": "Marriage Certificate",
                "value": "marriage"
              },
              {
                "label": "Death Certificate",
                "value": "death"
              }
            ],
            "required": true,
            "visibleWhen": {
              "field": "correct_other",
              "value": "yes",
              "operator": "equals"
            }
          },
          {
            "key": "other_entry",
            "type": "text",
            "label": "Which entry has the error?",
            "required": true,
            "placeholder": "e.g. Mother's maiden name, place of birth",
            "visibleWhen": {
              "field": "correct_other",
              "value": "yes",
              "operator": "equals"
            }
          },
          {
            "key": "other_current",
            "type": "text",
            "label": "How it is written now",
            "required": true,
            "visibleWhen": {
              "field": "correct_other",
              "value": "yes",
              "operator": "equals"
            }
          },
          {
            "key": "other_correct",
            "type": "text",
            "label": "How it should be written",
            "required": true,
            "visibleWhen": {
              "field": "correct_other",
              "value": "yes",
              "operator": "equals"
            }
          },
          {
            "key": "event_date",
            "type": "date",
            "label": "Date of the event on the record",
            "helpText": "As currently written on the record. For a birth record, this is the date of birth.",
            "required": true,
            "dateDirection": "past"
          },
          {
            "key": "event_place",
            "type": "text",
            "label": "Place of the event on the record",
            "required": true,
            "placeholder": "e.g. Legazpi City, Albay"
          },
          {
            "key": "reference_number",
            "type": "text",
            "label": "Registry number (if known)",
            "helpText": "Printed on your PSA or local civil registry copy.",
            "required": false
          },
          {
            "key": "registered_in_legazpi",
            "type": "select",
            "label": "Is the record registered at the Legazpi City CCRO?",
            "options": [
              {
                "label": "Yes, registered in Legazpi City",
                "value": "yes"
              },
              {
                "label": "No, registered in another city or municipality",
                "value": "no",
                "notice": {
                  "title": "Record registered elsewhere",
                  "variant": "warning",
                  "description": "Petitions for records kept by another local civil registrar are handled differently. CCRO staff will confirm how to proceed when you submit.",
                  "blocksProgress": false
                }
              },
              {
                "label": "I am not sure",
                "value": "unsure",
                "notice": {
                  "title": "Check your copy",
                  "variant": "default",
                  "description": "The place of registration is printed on your PSA or local civil registry copy. You can also ask at the CCRO window.",
                  "blocksProgress": false
                }
              }
            ],
            "required": true
          },
          {
            "key": "petitioner_relationship",
            "type": "select",
            "label": "Your relationship to the person named on the record",
            "options": [
              {
                "label": "I am the person named on the record",
                "value": "owner"
              },
              {
                "label": "Spouse",
                "value": "spouse"
              },
              {
                "label": "Child",
                "value": "child"
              },
              {
                "label": "Parent",
                "value": "parent"
              },
              {
                "label": "Brother or sister",
                "value": "sibling"
              },
              {
                "label": "Grandparent",
                "value": "grandparent"
              },
              {
                "label": "Guardian",
                "value": "guardian"
              },
              {
                "label": "Authorized representative",
                "value": "representative"
              }
            ],
            "required": true
          },
          {
            "key": "additional_notes",
            "type": "textarea",
            "label": "Additional notes",
            "blockKey": "additional_notes",
            "required": false,
            "placeholder": "Any special requests or instructions…"
          }
        ]
      },
      {
        "key": "details",
        "step": "details",
        "title": "Your details",
        "fields": [
          {
            "key": "subjects",
            "type": "person_group",
            "label": "Person named on the record",
            "required": true
          },
          {
            "key": "contact_number",
            "type": "phone",
            "label": "Contact number",
            "blockKey": "contact_number",
            "required": false,
            "placeholder": "9171234567"
          }
        ]
      }
    ],
    "caseSelector": {
      "title": "What does your petition cover?",
      "outcomes": [
        {
          "when": {
            "match": "any",
            "conditions": [
              {
                "field": "change_first_name",
                "value": "yes",
                "operator": "equals"
              },
              {
                "field": "correct_sex",
                "value": "yes",
                "operator": "equals"
              },
              {
                "field": "correct_birth_day_month",
                "value": "yes",
                "operator": "equals"
              }
            ]
          },
          "serviceCode": "RA9048-CFN"
        },
        {
          "when": {
            "match": "all",
            "conditions": [
              {
                "field": "change_first_name",
                "value": "no",
                "operator": "equals"
              },
              {
                "field": "correct_sex",
                "value": "no",
                "operator": "equals"
              },
              {
                "field": "correct_birth_day_month",
                "value": "no",
                "operator": "equals"
              },
              {
                "field": "correct_other",
                "value": "yes",
                "operator": "equals"
              }
            ]
          },
          "serviceCode": "RA9048-CCE"
        }
      ],
      "questions": [
        {
          "key": "change_first_name",
          "label": "Do you want to change the first name?",
          "options": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "description": "Change of first name or nickname under R.A. 9048."
        },
        {
          "key": "correct_sex",
          "label": "Do you want to correct the sex on the record?",
          "options": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "description": "Correction of a clerical error in the sex entry under R.A. 10172."
        },
        {
          "key": "correct_birth_day_month",
          "label": "Do you want to correct the day or month of birth?",
          "options": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "description": "Under R.A. 10172. Only the day and month can be corrected this way."
        },
        {
          "key": "correct_other",
          "label": "Do you want to correct another clerical or typographical error?",
          "options": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "description": "For example a misspelled name or place on a birth, marriage, or death record."
        }
      ],
      "description": "Answer each question. At least one must be Yes. One petition can combine a change of first name with a correction of sex or birth date."
    },
    "schemaVersion": 1
  },
