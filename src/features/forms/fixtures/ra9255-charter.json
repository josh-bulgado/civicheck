{
  "definition": {
    "sections": [
      {
        "key": "case",
        "step": "case",
        "title": "Case details",
        "fields": [
          {
            "key": "event_date",
            "type": "date",
            "label": "Child's date of birth",
            "helpText": "The child's age decides who signs the Affidavit to Use the Surname of the Father.",
            "required": true,
            "dateDirection": "past"
          },
          {
            "key": "event_place",
            "type": "text",
            "label": "Place where the child was born or registered",
            "required": true,
            "placeholder": "e.g. Legazpi City, Albay"
          },
          {
            "key": "reference_number",
            "type": "text",
            "label": "Registry number of the child's birth certificate (if known)",
            "required": false
          },
          {
            "key": "father_on_record",
            "type": "select",
            "label": "Did the father acknowledge the child on the birth certificate?",
            "options": [
              {
                "label": "Yes, the father acknowledged the child",
                "value": "yes"
              },
              {
                "label": "No, the father's name is blank or he did not sign",
                "value": "no"
              },
              {
                "label": "Not sure",
                "value": "not_sure"
              }
            ],
            "helpText": "That means his name is on it and he signed it. If it is blank or unsigned, a notarized Admission of Paternity is also needed.",
            "required": true
          },
          {
            "key": "filer_relationship",
            "type": "select",
            "label": "Your relationship to the child",
            "options": [
              {
                "label": "I am the child (18 years old or above)",
                "value": "self"
              },
              {
                "label": "The child's mother",
                "value": "mother"
              },
              {
                "label": "The child's legal guardian",
                "value": "guardian"
              },
              {
                "label": "Another relative",
                "value": "other_relative"
              }
            ],
            "helpText": "Children aged 7 to 17 sign with a notarized attestation from the mother or legal guardian. Children aged 18 and above sign for themselves.",
            "required": true
          },
          {
            "key": "additional_notes",
            "type": "textarea",
            "label": "Additional notes",
            "blockKey": "additional_notes",
            "required": false,
            "placeholder": "Any special requests or instructions…"
          }
        ]
      },
      {
        "key": "details",
        "step": "details",
        "title": "Your details",
        "fields": [
          {
            "key": "subjects",
            "type": "person_group",
            "label": "Person named on the record",
            "required": true
          },
          {
            "key": "contact_number",
            "type": "phone",
            "label": "Contact number",
            "blockKey": "contact_number",
            "required": false,
            "placeholder": "9171234567"
          }
        ]
      }
    ],
    "schemaVersion": 1
  },
