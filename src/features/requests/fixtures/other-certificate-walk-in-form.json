{
  "sections": [
    {
      "key": "case",
      "step": "case",
      "title": "Case details",
      "fields": [
        {
          "key": "record_type",
          "type": "select",
          "label": "Which record does it concern?",
          "options": [
            {
              "label": "Birth record",
              "value": "birth"
            },
            {
              "label": "Death record",
              "value": "death"
            },
            {
              "label": "Marriage record",
              "value": "marriage"
            }
          ],
          "required": true
        },
        {
          "key": "reference_number",
          "type": "text",
          "label": "Registry number",
          "required": false
        },
        {
          "key": "purpose",
          "type": "select",
          "label": "What will the certification be used for?",
          "options": [
            {
              "label": "Legal / Court proceedings",
              "value": "Legal / Court proceedings"
            },
            {
              "label": "Supporting document for a petition or correction",
              "value": "Supporting document for a petition or correction"
            },
            {
              "label": "Settlement of estate or property",
              "value": "Settlement of estate or property"
            },
            {
              "label": "Social Security (SSS/GSIS/etc.)",
              "value": "Social Security (SSS/GSIS/etc.)"
            },
            {
              "label": "Passport / Travel",
              "value": "Passport / Travel"
            },
            {
              "label": "Employment",
              "value": "Employment"
            },
            {
              "label": "School Records / Admission",
              "value": "School Records / Admission"
            },
            {
              "label": "Local Use (ID, Barangay, etc.)",
              "value": "Local Use (ID, Barangay, etc.)"
            },
            {
              "label": "Personal reference or records",
              "value": "Personal reference or records"
            },
            {
              "label": "Other",
              "value": "Other"
            }
          ],
          "required": true
        },
        {
          "key": "purpose_other",
          "type": "text",
          "label": "Specify purpose",
          "required": true,
          "placeholder": "e.g. Annulment case, visa application",
          "visibleWhen": {
            "field": "purpose",
            "value": "Other",
            "operator": "equals"
          }
        },
        {
          "key": "additional_notes",
          "type": "textarea",
          "label": "Additional notes",
          "blockKey": "additional_notes",
          "required": false,
          "placeholder": "Any special requests or instructions…"
        }
      ]
    },
    {
      "key": "details",
      "step": "details",
      "title": "Your details",
      "fields": [
        {
          "key": "subjects",
          "type": "person_group",
          "label": "Person named on the record",
          "required": true,
          "labelByAnswer": {
            "field": "record_type",
            "labels": {
              "marriage": "Name of husband"
            }
          }
        },
        {
          "key": "wife_first_name",
          "type": "text",
          "label": "Wife's first name",
          "inline": true,
          "required": true,
          "visibleWhen": {
            "field": "record_type",
            "value": "marriage",
            "operator": "equals"
          }
        },
        {
          "key": "wife_middle_name",
          "type": "text",
          "label": "Wife's maiden middle name",
          "inline": true,
          "required": true,
          "noneLabel": "No middle name",
          "visibleWhen": {
            "field": "record_type",
            "value": "marriage",
            "operator": "equals"
          }
        },
        {
          "key": "wife_last_name",
          "type": "text",
          "label": "Wife's maiden last name",
          "inline": true,
          "required": true,
          "visibleWhen": {
            "field": "record_type",
            "value": "marriage",
            "operator": "equals"
          }
        },
        {
          "key": "event_date",
          "type": "date",
          "label": "Date of the event on the record",
          "required": true,
          "dateDirection": "past",
          "labelByAnswer": {
            "field": "record_type",
            "labels": {
              "birth": "Date of Birth",
              "death": "Date of Death",
              "marriage": "Date of Marriage"
            }
          }
        },
        {
          "key": "event_place",
          "type": "text",
          "label": "Place of the event on the record",
          "required": true,
          "placeholder": "e.g. Hospital/clinic or house no., street, barangay, city/municipality, province",
          "labelByAnswer": {
            "field": "record_type",
            "labels": {
              "birth": "Place of Birth",
              "death": "Place of Death",
              "marriage": "Place of Marriage"
            }
          }
        },
        {
          "key": "mother_first_name",
          "type": "text",
          "label": "Mother's first name",
          "inline": true,
          "required": true,
          "visibleWhen": {
            "field": "record_type",
            "value": "birth",
            "operator": "equals"
          }
        },
        {
          "key": "mother_middle_name",
          "type": "text",
          "label": "Mother's middle name",
          "inline": true,
          "required": true,
          "noneLabel": "No middle name",
          "visibleWhen": {
            "field": "record_type",
            "value": "birth",
            "operator": "equals"
          }
        },
        {
          "key": "mother_last_name",
          "type": "text",
          "label": "Mother's maiden last name",
          "inline": true,
          "required": true,
          "visibleWhen": {
            "field": "record_type",
            "value": "birth",
            "operator": "equals"
          }
        },
        {
          "key": "father_name",
          "type": "text",
          "label": "Father's Full Name",
          "required": false,
          "visibleWhen": {
            "field": "record_type",
            "value": "birth",
            "operator": "equals"
          }
        },
        {
          "key": "registered_late",
          "type": "select",
          "label": "Registered late?",
          "options": [
            {
              "label": "No",
              "value": "no"
            },
            {
              "label": "Yes",
              "value": "yes"
            }
          ],
          "required": true
        },
        {
          "key": "registered_late_when",
          "type": "date",
          "label": "If yes, when was it registered?",
          "required": true,
          "visibleWhen": {
            "field": "registered_late",
            "value": "yes",
            "operator": "equals"
          },
          "allowEstimate": true,
          "dateDirection": "past"
        },
        {
          "key": "contact_number",
          "type": "phone",
          "label": "Contact number",
          "blockKey": "contact_number",
          "required": false,
          "placeholder": "9171234567"
        }
      ]
    }
  ],
  "schemaVersion": 1
}
