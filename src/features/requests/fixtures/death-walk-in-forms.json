{
  "death_ontime": {
    "sections": [
      {
        "key": "case",
        "step": "case",
        "title": "Case details",
        "fields": [
          {
            "key": "died_in_legazpi",
            "type": "select",
            "label": "Did the person pass away in Legazpi City?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no",
                "notice": {
                  "title": "We can only register deaths that occurred in Legazpi City",
                  "variant": "destructive",
                  "description": "On-time registration here covers deaths that occurred in Legazpi City. Register at the Local Civil Registrar of the city or municipality where the death occurred.",
                  "blocksProgress": true
                }
              }
            ],
            "required": true
          },
          {
            "key": "disposal_method",
            "type": "select",
            "label": "Was the deceased person buried or cremated?",
            "options": [
              {
                "label": "Buried",
                "value": "buried"
              },
              {
                "label": "Cremated",
                "value": "cremated"
              }
            ],
            "blockKey": "death_disposal",
            "helpText": "This information helps us identify the certificates required for registration.",
            "required": true
          },
          {
            "key": "embalmed",
            "type": "select",
            "label": "Were the remains embalmed?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "blockKey": "death_disposal",
            "helpText": "If the remains were not embalmed, a Certification of Not Embalmed is also required.",
            "required": true
          },
          {
            "key": "additional_notes",
            "type": "textarea",
            "label": "Additional notes",
            "blockKey": "additional_notes",
            "required": false,
            "placeholder": "Any special requests or instructions…"
          }
        ]
      },
      {
        "key": "details",
        "step": "details",
        "title": "Your details",
        "fields": [
          {
            "key": "subjects",
            "type": "person_group",
            "label": "Person named on the record",
            "required": true
          },
          {
            "key": "event_date",
            "type": "date",
            "label": "Date of death",
            "required": true,
            "dateDirection": "past"
          },
          {
            "key": "event_place",
            "type": "text",
            "label": "Place of death",
            "required": true,
            "placeholder": "e.g. Hospital name or house/street, barangay, city/municipality, province"
          }
        ]
      }
    ],
    "eventTiming": {
      "title": "This date is more than 30 days ago",
      "behavior": "redirect_confirm",
      "ctaLabel": "Switch to Delayed Registration",
      "mismatch": "outside_window",
      "timezone": "Asia/Manila",
      "windowDays": 30,
      "description": "Use the registration track that matches the death date.",
      "triggerField": "event_date",
      "targetServiceCode": "DEATH_DELAYED",
      "requireDocumentFirst": false
    },
    "schemaVersion": 1
  },
  "death_delayed": {
